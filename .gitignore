# Python and virtual environments
__pycache__/
*.py[cod]
.venv/
venv/
.env
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Local logs and temporary files
*.log
*.tmp
*.bak
.cache/
local-data/
captures/
dumps/
raw-data/

# Windows driver packages and other proprietary binaries
*.dll
*.exe
*.sys
*.cat
*.inf
*.msi
7_Fingerprint-module.zip

# Sensitive fingerprint results or templates
*.fpt
*.template
*.fpdata
*.pcap
*.pcapng
*.bin

# Never stage genuine fingerprint captures even if copied outside local-data/
# Public demonstrations should use separately generated, clearly labelled synthetic samples.
fingerprint_*.raw
fingerprint_*.png

# Real 5955 captures may also be stored under other private names.
# Ignore raw, PGM and Windows biometric-record files anywhere in the tree.
# Synthetic test samples, if needed, should be explicitly reviewed before
# being added, never force-added from an unexamined local capture directory.
*.raw
*.pgm
*.bir
