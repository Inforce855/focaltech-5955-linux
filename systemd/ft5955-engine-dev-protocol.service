# Development ONLY. Dedicated MOH enrol/verify protocol evaluation. NO PAM integration.
# Run under a separately created non-login ft5955-engine account.
[Unit]
Description=FT5955 independent MOH template protocol development service
Requires=ft5955-engine-dev.socket
After=ft5955-engine-dev.socket
[Service]
Type=simple
User=ft5955-engine
Group=ft5955-engine
ExecStart=/usr/bin/python3 -I -B /opt/ft5955-dev/ft5955_dev_protocol_server.py
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictSUIDSGID=yes
LockPersonality=yes
IPAddressDeny=any
TimeoutStopSec=10
